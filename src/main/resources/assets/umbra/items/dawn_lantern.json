{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "umbra:item/dawn_lantern"
        }
      },
      {
        "when": [
          "firstperson_righthand",
          "firstperson_lefthand"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "umbra:item/dawn_lantern_fp"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "umbra:item/dawn_lantern_3d"
    }
  }
}