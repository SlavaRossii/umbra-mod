{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:has_component",
    "component": "umbra:lit",
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": [
            "gui"
          ],
          "model": {
            "type": "minecraft:model",
            "model": "umbra:item/luminite_lantern"
          }
        },
        {
          "when": [
            "firstperson_righthand",
            "firstperson_lefthand"
          ],
          "model": {
            "type": "minecraft:model",
            "model": "umbra:item/luminite_lantern_fp"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "umbra:item/luminite_lantern_3d"
      }
    },
    "on_false": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": [
            "gui"
          ],
          "model": {
            "type": "minecraft:model",
            "model": "umbra:item/luminite_lantern"
          }
        },
        {
          "when": [
            "firstperson_righthand",
            "firstperson_lefthand"
          ],
          "model": {
            "type": "minecraft:model",
            "model": "umbra:item/luminite_lantern_off_fp"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "umbra:item/luminite_lantern_off_3d"
      }
    }
  }
}